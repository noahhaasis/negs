Make AppStream optional so the Negs AppImage need not bundle libappstream,
curl, libxml2 and ICU. Only the *_new_from_appdata() constructors, which
Negs does not call, depend on it.

diff -ru a/src/adw-about-dialog.c b/src/adw-about-dialog.c
--- a/src/adw-about-dialog.c
+++ b/src/adw-about-dialog.c
@@ -7,7 +7,9 @@
 
 #include "config.h"
 #include <glib/gi18n-lib.h>
+#ifdef HAVE_APPSTREAM
 #include <appstream.h>
+#endif
 
 #include "adw-about-dialog.h"
 
@@ -423,12 +425,14 @@
   self->legal_showing_idle_id = 0;
 }
 
+#ifdef HAVE_APPSTREAM
 static gboolean
 get_release_for_version (AsRelease  *rel,
                          const char *version)
 {
   return !g_strcmp0 (as_release_get_version (rel), version);
 }
+#endif
 
 static void
 update_credits_legal_group (AdwAboutDialog *self)
@@ -2000,6 +2004,11 @@
 adw_about_dialog_new_from_appdata (const char *resource_path,
                                    const char *release_notes_version)
 {
+#ifndef HAVE_APPSTREAM
+  g_return_val_if_fail (resource_path, NULL);
+  g_critical ("libadwaita was built without AppStream; cannot read %s", resource_path);
+  return ADW_DIALOG (adw_about_dialog_new ());
+#else
   AdwAboutDialog *self;
   GFile *appdata_file;
   char *appdata_uri;
@@ -2145,6 +2154,7 @@
   g_free (appdata_uri);
 
   return ADW_DIALOG (self);
+#endif
 }
 
