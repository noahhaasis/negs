{
  "id": "io.github.noahhaasis.negs",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "negs",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a"
  ],
  "modules": [
    {
      "name": "openblas",
      "buildsystem": "simple",
      "build-commands": [
        "make DYNAMIC_ARCH=1 TARGET=GENERIC NUM_THREADS=128 USE_OPENMP=0 USE_THREAD=1 NO_AFFINITY=1 ONLY_CBLAS=1 NO_STATIC=1",
        "make DYNAMIC_ARCH=1 TARGET=GENERIC NUM_THREADS=128 USE_OPENMP=0 USE_THREAD=1 NO_AFFINITY=1 ONLY_CBLAS=1 NO_STATIC=1 PREFIX=/app install",
        "install -Dm644 LICENSE /app/share/licenses/negs/OpenBLAS-LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.34/OpenBLAS-0.3.34.tar.gz",
          "sha256": "cd7e129868320cc2d033afa920e31202dfe0b8066a5b66661900ccc0f197dfed"
        }
      ]
    },
    {
      "name": "negs",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/negs/cargo",
          "NEGS_TOOLCHAIN": "",
          "NEGS_PACKAGED": "1",
          "NEGS_CARGO_OFFLINE": "1",
          "NEGS_ENGINE_TARGET_DIR": "/run/build/negs/target",
          "NEGS_UI_TARGET_DIR": "/run/build/negs/target/linux-ui"
        }
      },
      "build-commands": [
        "bash linux/build.sh",
        "python3 linux/stage.py --format flatpak --destdir / --prefix /app --engine-target /run/build/negs/target --ui-target /run/build/negs/target/linux-ui",
        "install -Dm755 linux/flatpak/negs-launcher /app/bin/negs"
      ],
      "sources": [
        "cargo-sources.json",
        "cargo-sources-linux.json",
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            "target",
            ".git",
            ".worktrees",
            "macos",
            "windows",
            "experimental",
            ".flatpak-builder"
          ]
        }
      ]
    }
  ]
}
