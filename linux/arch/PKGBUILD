pkgname=negs
pkgver=0.7.0
pkgrel=1
pkgdesc='Native GTK4 photographic film simulation editor'
arch=('x86_64')
url='https://github.com/noahhaasis/negs'
license=('GPL-3.0-only')
depends=('gtk4>=4.16' 'libadwaita>=1.6' 'openblas' 'vulkan-icd-loader' 'python' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('rustup' 'pkgconf')
optdepends=('vulkan-driver: hardware accelerated preview and Fast export')
options=('!lto')
source=("negs-$pkgver.tar.gz")
sha256sums=('SKIP') # package.sh replaces this with the local source SHA-256.

build() {
    cd "$srcdir/negs-$pkgver"
    bash linux/build.sh
}

package() {
    cd "$srcdir/negs-$pkgver"
    python3 linux/stage.py --destdir "$pkgdir" --prefix /usr \
        --source-archive "$srcdir/negs-$pkgver.tar.gz"
}
